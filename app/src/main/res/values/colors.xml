<?xml version="1.0" encoding="utf-8"?>
<!--
    COLORES DE LA APP.
    Un color se escribe en formato #AARRGGBB: transparencia (FF = opaco) + rojo + verde + azul.
    En los diseños y el tema se usan por su nombre, por ejemplo @color/azul_chocosalud.
-->
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Paleta tomada del logo de ChocóSalud -->
    <color name="azul_chocosalud">#FF0B4F62</color>
    <color name="azul_oscuro">#FF083749</color>
    <color name="dorado">#FFC5A03D</color>
    <color name="crema">#FFF3EDD5</color>
</resources>
