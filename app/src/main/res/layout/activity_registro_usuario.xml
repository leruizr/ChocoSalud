<?xml version="1.0" encoding="utf-8"?>
<!--
    DISEÑO DE LA PANTALLA 2: Registro de usuario (lógica en ActivityRegistroUsuario.java).

    Estructura: igual que el inicio de sesión.
      LinearLayout (raíz, id "main")
        └─ ScrollView (para poder desplazar el formulario)
             └─ LinearLayout (contenido)
                  ├─ logo, título y subtítulo
                  ├─ seis campos de texto (nombre, documento, correo, teléfono,
                  │  contraseña y confirmar contraseña)
                  ├─ botón "Registrarme"
                  └─ botón de texto "¿Ya tienes cuenta? Inicia sesión"

    Cada campo se compone de un TextInputLayout (caja con borde, etiqueta y mensaje de error)
    y un TextInputEditText (donde se escribe). Convención de ids del proyecto:
    "layout..." para la caja y "campo..." para el texto.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ActivityRegistroUsuario">

    <!-- ScrollView: permite desplazar el formulario, porque tiene más campos de los que
         caben en pantalla (y más aún con el teclado abierto). -->
    <ScrollView
        android:id="@+id/scrollFormulario"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <!-- Único hijo del ScrollView: contiene todo el formulario. -->
        <LinearLayout
            android:id="@+id/contenidoFormulario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Logo, centrado horizontalmente -->
            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="@string/logo_descripcion"
                android:src="@drawable/logo_chocosalud" />

            <!-- Título -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/registro_titulo"
                android:textColor="?attr/colorPrimary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- Subtítulo -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:text="@string/registro_subtitulo"
                android:textColor="?attr/colorOnBackground"
                android:textSize="16sp" />

            <!-- CAMPO 1: Nombre completo.
                 style="...OutlinedBox": caja con solo borde (estilo de Material Design 3).
                 hint: la etiqueta que flota sobre el campo.
                 inputType="textPersonName|textCapWords": teclado para nombres y pone en
                 mayúscula la primera letra de cada palabra. -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutNombreCompleto"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_nombre_completo">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campoNombreCompleto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- CAMPO 2: Número de documento. inputType="number": el teclado solo muestra
                 números. layout_marginTop separa este campo del anterior. -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutDocumento"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/hint_documento">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campoDocumento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- CAMPO 3: Correo electrónico. inputType="textEmailAddress": teclado con @. -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutCorreo"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/hint_correo">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campoCorreo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- CAMPO 4: Teléfono. inputType="phone": teclado numérico de teléfono. -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutTelefono"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/hint_telefono">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campoTelefono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- CAMPO 5: Contraseña.
                 endIconMode="password_toggle": agrega el "ojito" para mostrar u ocultar.
                 inputType="textPassword": oculta lo escrito. maxLength="4": máximo 4 caracteres. -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutContrasena"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/hint_contrasena"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campoContrasena"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLength="4" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- CAMPO 6: Confirmar contraseña (igual que el anterior; el código Java
                 comprueba que ambas coincidan). -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutConfirmarContrasena"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/hint_confirmar_contrasena"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campoConfirmarContrasena"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLength="4" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Botón "Registrarme": onClick="registrarUsuario" llama al método
                 registrarUsuario(View) de ActivityRegistroUsuario.java. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonRegistrar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:onClick="registrarUsuario"
                android:text="@string/boton_registrar"
                android:textSize="16sp" />

            <!-- Enlace para volver al inicio de sesión (estilo TextButton: solo texto). -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonIrInicioSesion"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:onClick="irInicioSesion"
                android:text="@string/registro_con_cuenta" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
