<?xml version="1.0" encoding="utf-8"?>
<!-- DISEÑO de la pantalla "Mis citas" (lógica en ActivityMisCitas.java) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".ActivityMisCitas">

    <!-- Logo -->
    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="center_horizontal"
        android:contentDescription="@string/logo_descripcion"
        android:src="@drawable/logo_chocosalud" />

    <!-- Título y subtítulo -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/mis_citas_titulo"
        android:textColor="?attr/colorPrimary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:text="@string/mis_citas_subtitulo"
        android:textColor="?attr/colorOnBackground"
        android:textSize="16sp" />

    <!-- Lista de citas: se llena desde la tabla citas de la base de datos -->
    <ListView
        android:id="@+id/listaCitas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Texto que se muestra cuando el usuario no tiene citas -->
    <TextView
        android:id="@+id/textoSinCitas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/mis_citas_vacio"
        android:textColor="?attr/colorOnBackground"
        android:textSize="16sp"
        android:visibility="gone" />

</LinearLayout>
