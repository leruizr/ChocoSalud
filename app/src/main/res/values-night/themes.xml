<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        TEMA VISUAL (modo oscuro).
        La carpeta "values-night" es especial: Android usa estos valores cuando el teléfono
        está en modo oscuro, en lugar de los de res/values/themes.xml. Aquí se invierten los
        colores: fondo azul oscuro y el dorado como color principal para que se lea bien.
    -->
    <style name="Base.Theme.ChocoSalud" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/dorado</item>
        <item name="colorOnPrimary">@color/azul_oscuro</item>
        <item name="colorSecondary">@color/dorado</item>
        <item name="android:colorBackground">@color/azul_oscuro</item>
        <item name="colorSurface">@color/azul_oscuro</item>
    </style>
</resources>
